# Public app origin used in NFC/QR URLs and auth redirects.
# Local example: http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Vite exposes only VITE_* variables to the browser.
# These must be the Supabase project URL and the anon (public) key.
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with VITE_. Never put this in client code.
# Used later for trusted Edge Functions, admin jobs, and migrations tooling.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional local Supabase CLI (supabase start / supabase db push)
# SUPABASE_PROJECT_ID=your-project-ref
